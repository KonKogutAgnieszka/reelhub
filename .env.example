# TMDB API
# Get your token at: https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=your_tmdb_v4_token_here

# TMDB API base URL (default: https://api.themoviedb.org/3)
TMDB_API_URL=https://api.themoviedb.org/3

# TMDB image base URL (for posters and backdrops)
TMDB_IMAGE_URL=https://image.tmdb.org/t/p